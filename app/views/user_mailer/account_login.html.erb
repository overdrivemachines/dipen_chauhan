<table class="email-header" role="presentation" width="100%">
  <tr>
    <td class="email-brand">
      <img src="https://dipenchauhan.com/icon.png" width="48" height="48" alt="Dipen Chauhan" style="display: block; width: 48px; height: 48px; margin-bottom: 16px;">
      Dipen Chauhan
    </td>
  </tr>
</table>

<div class="email-content">
  <h1 class="email-title">Your login link is ready</h1>

  <p class="email-copy">
    Use the button below to sign in to your account.
  </p>

  <p class="email-copy">
    This link expires in 2 hours and can only be used once.
  </p>

  <p style="margin: 28px 0;">
    <%= link_to "Sign in", edit_session_url(@user.login_token, email: @user.email), class: "email-button" %>
  </p>

  <div class="email-fallback">
    If the button does not work, copy and paste this link into your browser:<br>
    <%= link_to edit_session_url(@user.login_token, email: @user.email), edit_session_url(@user.login_token, email: @user.email), class: "email-link" %>
  </div>

  <p class="email-copy" style="margin: 24px 0 0;">
    If you did not request this email, you can safely ignore it.
  </p>
</div>
